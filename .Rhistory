capa <- capa[!st_is_empty(capa), ]
# 3. Limpieza Fila por Fila para evitar colapso de GEOS en líneas inválidas
geom_list <- st_geometry(capa)
filas_validas <- vector("logical", length(geom_list))
for (i in seq_along(geom_list)) {
g <- geom_list[[i]]
valida <- tryCatch({
if (geom_tipo == "LINESTRING") {
# Extraer matriz de coordenadas
coords <- unclass(g)
if (is.list(coords)) {
# Si es MULTILINESTRING
all(sapply(coords, function(m) is.matrix(m) && nrow(m) >= 2))
} else if (is.matrix(coords)) {
# Si es LINESTRING simple
nrow(coords) >= 2
} else {
FALSE
}
} else {
TRUE
}
}, error = function(e) FALSE)
filas_validas[i] <- valida
}
capa <- capa[filas_validas, , drop = FALSE]
if (nrow(capa) == 0) {
message(sprintf("⚠️ Sin registros con geometrías válidas: %s", nombre_salida))
return(NULL)
}
# 4. Extraer el tipo de geometría si se especificó
if (!is.null(geom_tipo)) {
capa <- suppressWarnings(st_collection_extract(capa, geom_tipo))
capa <- capa[!st_is_empty(capa), ]
}
# 5. Proyección CRS
# 5. Proyección CRS
if (is.na(st_crs(capa))) {
bb <- st_bbox(capa)
parece_geografico <- bb["xmin"] >= -180 && bb["xmax"] <= 180 &&
bb["ymin"] >= -90  && bb["ymax"] <= 90
if (parece_geografico) {
message(sprintf("ℹ️ %s: CRS no legible pero coordenadas ya parecen WGS84 (grados). Asignando 4326 directo.", nombre_salida))
st_crs(capa) <- 4326
} else {
message(sprintf("⚠️ %s: CRS no legible, coordenadas parecen proyectadas. Asumiendo POSGAR 5347.", nombre_salida))
st_crs(capa) <- 5347
}
}
capa <- tryCatch(st_transform(capa, 4326), error = function(e) {
st_crs(capa) <- 4326
capa
})
# Validación de seguridad: si después de todo esto el resultado sigue fuera de CABA, avisar fuerte
bbox_caba <- c(xmin = -58.60, xmax = -58.30, ymin = -34.75, ymax = -34.50)
bb_final <- st_bbox(capa)
if (bb_final["xmin"] < bbox_caba["xmin"] || bb_final["xmax"] > bbox_caba["xmax"] ||
bb_final["ymin"] < bbox_caba["ymin"] || bb_final["ymax"] > bbox_caba["ymax"]) {
warning(sprintf("🚨 %s: bbox final fuera de CABA: %s", nombre_salida, paste(round(bb_final, 3), collapse = ", ")))
}
if (!is.null(geom_tipo) && geom_tipo %in% c("LINESTRING", "POLYGON")) {
capa <- tryCatch({
ms_simplify(capa, keep = keep_ratio, keep_shapes = TRUE)
}, error = function(e) {
suppressWarnings(st_simplify(capa, dTolerance = 0.0001, preserveTopology = TRUE))
})
}
# 7. Calcular longitud en metros si es línea
if (!is.null(geom_tipo) && geom_tipo == "LINESTRING") {
capa$longitud_m <- as.numeric(suppressWarnings(st_length(capa)))
}
# 8. Guardar GeoJSON
path_salida <- file.path(dir_destino, paste0(nombre_salida, ".geojson"))
if (file.exists(path_salida)) unlink(path_salida)
st_write(capa, path_salida, driver = "GeoJSON", quiet = TRUE)
message(sprintf("✅ Guardado: %s (%s registros)", path_salida, nrow(capa)))
return(capa)
}
# =============================================================================
# 3. PROCESAR TODAS LAS CAPAS DE TU PROYECTO
# =============================================================================
# Capas Vectoriales (Líneas / Polígonos / Puntos)
optimizar_y_guardar(file.path(dir_origen, "CAO/Metrotel/CAO - METROTEL CALLEJERO.shp"), "cao_metrotel", "LINESTRING")
optimizar_y_guardar(file.path(dir_origen, "Reordenamiento_de_Cables/Reordenamiento de cables consolidado.shp"), "reordenamiento", "LINESTRING")
optimizar_y_guardar(file.path(dir_origen, "Reordenamiento_de_Cables/Poligonos Protocolo/ZONAS APH - Nuevas Propuestas.shp"), "zonas_aph", "POLYGON")
optimizar_y_guardar(file.path(dir_origen, "APH/APH TA 2026.shp"), "aph_trazas", "LINESTRING")
optimizar_y_guardar(file.path(dir_origen, "Reordenamiento_de_Cables/Poligonos Protocolo/Poligonos Protocolo.shp"), "poligonos_protocolo", "POLYGON")
optimizar_y_guardar(file.path(dir_origen, "ASI/CAO ASI nuevos poligonos consolidado.shp"), "asi_aereo", "LINESTRING")
optimizar_y_guardar(file.path(dir_origen, "ASI/Tendido ASI.shp"), "asi_soterrado", "LINESTRING")
optimizar_y_guardar(file.path(dir_origen, "Postes_y_Trazas/CONSOLIDADO RELEVAMIENTO EN CALLE - POSTES.shp"), "postes_relevados", "POINT")
optimizar_y_guardar(file.path(dir_origen, "Reordenamiento_de_Cables/TELEFONICA/TELEFONICA REORDENAMIENTO - PUNTOS.shp"), "telefonica_postes", "POINT")
optimizar_y_guardar(file.path(dir_origen, "Postes_y_Trazas/CONSOLIDADO RELEVAMIENTO EN CALLE - TA.shp"), "trazas_relevadas", "LINESTRING")
optimizar_y_guardar(file.path(dir_origen, "Tendido_Policia_Federal/Tendido_Policia_Federal.shp"), "tendido_policia", "LINESTRING")
optimizar_y_guardar(file.path(dir_origen, "Trazas_intimadas/Trazas Intimadas.shp"), "trazas_intimadas", "LINESTRING")
# Capas de Límites de CABA (Comunas y Barrios)
url_comunas <- "https://cdn.buenosaires.gob.ar/datosabiertos/datasets/ministerio-de-educacion/comunas/comunas.geojson"
url_barrios <- "https://cdn.buenosaires.gob.ar/datosabiertos/datasets/barrios/barrios.geojson"
message("🌐 Descargando y optimizando Comunas y Barrios de CABA...")
comunas <- st_read(url_comunas, quiet = TRUE) %>% st_transform(4326)
barrios <- st_read(url_barrios, quiet = TRUE) %>% st_transform(4326)
st_write(comunas, file.path(dir_destino, "comunas.geojson"), driver = "GeoJSON", delete_dsn = TRUE, quiet = TRUE)
st_write(barrios, file.path(dir_destino, "barrios.geojson"), driver = "GeoJSON", delete_dsn = TRUE, quiet = TRUE)
message("\n🎉 ¡Preprocesamiento finalizado! Los archivos GeoJSON están listos en 'data_web/'.")
rmarkdown::render("index.Rmd")
