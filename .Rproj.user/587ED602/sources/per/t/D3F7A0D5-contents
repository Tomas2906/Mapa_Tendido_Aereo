js_script <- HTML(r"(
<script src='https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js'></script>
<script>
function toggleCapa(input) {
  var nombre = input.getAttribute('data-nombre');
  var visible = input.checked;
  var layers = window.mapaCABA && window.mapaCABA._grupos ? window.mapaCABA._grupos[nombre] : null;

  if (layers) {
    layers.forEach(function(layer) {
      if (visible) {
        if (!window.mapaCABA.hasLayer(layer)) window.mapaCABA.addLayer(layer);
      } else {
        if (window.mapaCABA.hasLayer(layer)) window.mapaCABA.removeLayer(layer);
      }
    });
  }
  recalcularTotales();
}

function togglePopover(botonEl, id) {
  var fuente = document.getElementById(id);
  if (!fuente) return;

  var flotante = document.getElementById('popover-flotante');
  if (!flotante) {
    flotante = document.createElement('div');
    flotante.id = 'popover-flotante';
    document.body.appendChild(flotante);
  }

  var mismoOrigenYaAbierto = flotante.classList.contains('active') && flotante.getAttribute('data-origen') === id;
  flotante.classList.remove('active');
  if (mismoOrigenYaAbierto) return;

  flotante.innerHTML = fuente.innerHTML;
  flotante.setAttribute('data-origen', id);

  var rectBoton = botonEl.getBoundingClientRect();
  var anchoPop = 210;
  var left = rectBoton.left - anchoPop + rectBoton.width;
  left = Math.max(8, Math.min(left, window.innerWidth - anchoPop - 8));
  var top = rectBoton.bottom + 4;

  flotante.style.left = left + 'px';
  flotante.style.top = top + 'px';
  flotante.classList.add('active');
}

function manejarClickPanel(e) {
  var btnInfo = e.target.closest('.btn-info-legend');
  if (btnInfo) {
    e.stopPropagation();
    togglePopover(btnInfo, btnInfo.getAttribute('data-pop-id'));
    return;
  }

  var btnDesc = e.target.closest('.btn-download-legend');
  if (btnDesc) {
    e.stopPropagation();
    descargarCapaKML(btnDesc.getAttribute('data-nombre'));
    return;
  }

  var kpiDescargarTrazas = e.target.closest('#kpi-card-trazas');
  if (kpiDescargarTrazas) {
    abrirModalTabla('trazas');
    return;
  }

  var kpiDescargarPostes = e.target.closest('#kpi-card-postes');
  if (kpiDescargarPostes) {
    abrirModalTabla('postes');
    return;
  }

  var header = e.target.closest('.panel-header');
  if (header) {
    header.parentElement.classList.toggle('collapsed');
    return;
  }
}

document.addEventListener('change', function(e) {
  if (e.target.classList && e.target.classList.contains('chk-capa')) {
    toggleCapa(e.target);
  }
});

document.addEventListener('click', function(e) {
  var flotante = document.getElementById('popover-flotante');
  if (flotante && flotante.classList.contains('active') && !e.target.closest('#popover-flotante')) {
    flotante.classList.remove('active');
  }
});

function recalcularTotales() {
  var totalTrazas = 0;
  var totalPostes = 0;

  var checkboxes = document.querySelectorAll('#panel-filtros input[type="checkbox"]');
  checkboxes.forEach(function(cb) {
    if (cb.checked) {
      var cant = parseInt(cb.getAttribute('data-cant')) || 0;
      var nombre = cb.getAttribute('data-nombre') || '';

      if (nombre.indexOf('Postes') !== -1 || nombre.indexOf('Telefónica') !== -1) {
        totalPostes += cant;
      } else if (nombre.indexOf('Comunas') === -1 && nombre.indexOf('Zonas APH') === -1 && nombre.indexOf('Polígonos') === -1) {
        totalTrazas += cant;
      }
    }
  });

  var elemTrazas = document.getElementById('kpi-val-trazas');
  var elemPostes = document.getElementById('kpi-val-postes');
  if (elemTrazas) elemTrazas.innerText = totalTrazas.toLocaleString('es-AR');
  if (elemPostes) elemPostes.innerText = totalPostes.toLocaleString('es-AR');
}

var registrosEstructurados = [];
var tipoTablaActual = 'trazas';

function cerrarModalTabla() {
  var modal = document.getElementById('modal-datos');
  if (modal) modal.classList.remove('active');
}

function abrirModalTabla(tipo) {
  if (!window.mapaCABA || !window.mapaCABA._grupos) return;

  tipoTablaActual = tipo || 'trazas';
  registrosEstructurados = [];
  var contenedorTabla = document.getElementById('contenedor-tabla-modal');
  var tituloModal = document.getElementById('modal-titulo');
  
  if (tituloModal) {
    tituloModal.innerText = (tipoTablaActual === 'postes') ? 'Detalle de Postes Visibles' : 'Detalle de Trazas Visibles';
  }
  
  contenedorTabla.innerHTML = '';

  document.querySelectorAll('#panel-filtros input[type="checkbox"]').forEach(function(cb) {
    var nombre = cb.getAttribute('data-nombre');
    var esPoste = (nombre.indexOf('Postes') !== -1 || nombre.indexOf('Telefónica') !== -1);
    var esValido = (tipoTablaActual === 'postes') ? esPoste : (!esPoste && nombre !== 'Comunas' && nombre.indexOf('Zonas APH') === -1 && nombre.indexOf('Polígonos') === -1);

    if (cb.checked && esValido && window.mapaCABA._grupos[nombre]) {
      var layers = window.mapaCABA._grupos[nombre];
      
      layers.forEach(function(layer) {
        var rawData = layer.options && layer.options.data_json;
        if (rawData) {
          try {
            var items = typeof rawData === 'string' ? JSON.parse(rawData) : rawData;
            items.forEach(function(item) {
              var registro = { 'Capa': nombre };
              Object.keys(item).forEach(function(key) {
                if (key !== 'popup_fmt' && key !== 'color_map' && key !== 'empresa_cat') {
                  registro[key] = (item[key] !== null && item[key] !== undefined) ? item[key] : '-';
                }
              });
              registrosEstructurados.push(registro);
            });
          } catch(e) {
            console.error('Error parseando data_json', e);
          }
        }
      });
    }
  });

  if (registrosEstructurados.length === 0) {
    contenedorTabla.innerHTML = '<p style="text-align:center; padding:20px;">No hay datos visibles para mostrar en esta categoría.</p>';
    document.getElementById('modal-datos').classList.add('active');
    return;
  }

  var columnasSet = new Set();
  registrosEstructurados.forEach(function(r) {
    Object.keys(r).forEach(function(k) { columnasSet.add(k); });
  });
  var columnas = Array.from(columnasSet);

  var htmlTabla = '<table class="tabla-datos"><thead><tr>';
  columnas.forEach(function(col) {
    htmlTabla += '<th>' + col + '</th>';
  });
  htmlTabla += '</tr></thead><tbody>';
  
  registrosEstructurados.forEach(function(r) {
    htmlTabla += '<tr>';
    columnas.forEach(function(col) {
      htmlTabla += '<td>' + (r[col] !== undefined ? r[col] : '-') + '</td>';
    });
    htmlTabla += '</tr>';
  });
  
  htmlTabla += '</tbody></table>';
  contenedorTabla.innerHTML = htmlTabla;

  document.getElementById('modal-datos').classList.add('active');
}

function descargarExcel() {
  if (registrosEstructurados.length === 0) {
    alert('No hay datos para exportar.');
    return;
  }
  
  var worksheet = XLSX.utils.json_to_sheet(registrosEstructurados);
  var workbook = XLSX.utils.book_new();
  var nombreHoja = tipoTablaActual === 'postes' ? 'Postes_Visibles' : 'Trazas_Visibles';
  XLSX.utils.book_append_sheet(workbook, worksheet, nombreHoja);
  
  XLSX.writeFile(workbook, nombreHoja + '_Originales_CABA.xlsx');
}

function layerAKmlPlacemark(layer, nombreCapa) {
  var out = '';
  if (layer.getLatLng) {
    var ll = layer.getLatLng();
    out += '<Placemark><name>' + nombreCapa + '</name><Point><coordinates>' +
           ll.lng + ',' + ll.lat + ',0</coordinates></Point></Placemark>';
  } else if (layer.getLatLngs) {
    var lls = layer.getLatLngs();
    var anillos = Array.isArray(lls[0]) ? lls : [lls];
    anillos.forEach(function(anillo) {
      var pts = Array.isArray(anillo[0]) ? anillo[0] : anillo;
      if (!pts || !pts.length) return;
      var coords = '';
      pts.forEach(function(p) { if (p && typeof p.lng !== 'undefined') coords += p.lng + ',' + p.lat + ',0 '; });
      if (coords) {
        out += '<Placemark><name>' + nombreCapa + '</name><LineString><coordinates>' +
               coords + '</coordinates></LineString></Placemark>';
      }
    });
  }
  return out;
}

function construirKML(gruposAExportar) {
  var xmlnsStr = 'http' + '://' + 'www.opengis.net/kml/2.2';
  var kmlHeader = '<?xml version="1.0" encoding="UTF-8"?><kml xmlns="' + xmlnsStr + '"><Document>';
  var kmlFooter = '</Document></kml>';
  var kmlBody = '';

  Object.keys(gruposAExportar).forEach(function(nombreCapa) {
    var layers = gruposAExportar[nombreCapa];
    kmlBody += '<Folder><name>' + nombreCapa + '</name>';
    layers.forEach(function(layer) {
      kmlBody += layerAKmlPlacemark(layer, nombreCapa);
    });
    kmlBody += '</Folder>';
  });

  return kmlHeader + kmlBody + kmlFooter;
}

function descargarBlobKML(contenidoKml, nombreArchivo) {
  var blob = new Blob([contenidoKml], {type: 'application/vnd.google-earth.kml+xml'});
  var link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = nombreArchivo;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  setTimeout(function() { URL.revokeObjectURL(link.href); }, 1000);
}

function descargarCapaKML(nombreCapa) {
  if (!window.mapaCABA || !window.mapaCABA._grupos || !window.mapaCABA._grupos[nombreCapa]) {
    alert('No se encontraron datos para la capa "' + nombreCapa + '".');
    return;
  }
  var grupos = {};
  grupos[nombreCapa] = window.mapaCABA._grupos[nombreCapa];
  var kml = construirKML(grupos);
  var archivo = nombreCapa.replace(/[^a-z0-9]+/gi, '_') + '.kml';
  descargarBlobKML(kml, archivo);
}
</script>
