    trazas_relevadas$emp_cat <- as.character(trazas_relevadas[[col_emp_rel]])
    trazas_relevadas$emp_cat[is.na(trazas_relevadas$emp_cat) | trazas_relevadas$emp_cat == ""] <- "S/D"
  } else {
