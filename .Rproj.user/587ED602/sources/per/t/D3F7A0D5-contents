  pal_trazas_rel <- colorFactor(palette = "Dark2", domain = emp_cats)
  trazas_relevadas$color_map <- pal_trazas_rel(trazas_relevadas$emp_cat)
  for (e in emp_cats) { trazas_rel_info[[e]] <- pal_trazas_rel(e) }
}

postes_rel_info <- list()
