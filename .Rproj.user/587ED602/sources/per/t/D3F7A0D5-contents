if (!is.null(comunas)) {
  col_c <- names(comunas)[grep("comuna|nombre|id", names(comunas), ignore.case = TRUE)][1]
  comunas$label_comuna <- if (!is.na(col_c)) paste0("Comuna ", comunas[[col_c]]) else "Comuna CABA"
}

if (!is.null(poligonos_prot)) {
  col_zona <- names(poligonos_prot)[grep("zona|cat|tipo|nombre", names(poligonos_prot), ignore.case = TRUE)][1]
  if (!is.na(col_zona)) {
    poligonos_prot$zona_cat <- as.character(poligonos_prot[[col_zona]])
    poligonos_prot$zona_cat[is.na(poligonos_prot$zona_cat) | poligonos_prot$zona_cat == ""] <- "S/D"
  } else {
    poligonos_prot$zona_cat <- "General"
  }
  zonas_unicas <- unique(poligonos_prot$zona_cat)
  paleta_zonas <- colorFactor(palette = "Set3", domain = zonas_unicas)
  poligonos_prot$color_map <- paleta_zonas(poligonos_prot$zona_cat)
}

reord_lista <- list()
if (!is.null(reordenamiento)) {
  col_emp <- names(reordenamiento)[grep("empresa|operador|prestador", names(reordenamiento), ignore.case = TRUE)][1]
  if (!is.na(col_emp)) {
    reordenamiento$empresa_cat <- as.character(reordenamiento[[col_emp]])
    reordenamiento$empresa_cat[is.na(reordenamiento$empresa_cat) | reordenamiento$empresa_cat == ""] <- "S/D"
  } else {
    reordenamiento$empresa_cat <- "Sin Empresa"
  }
  empresas_unicas <- unique(reordenamiento$empresa_cat)
  paleta_emp <- colorFactor(palette = "Set1", domain = empresas_unicas)
  for (emp in empresas_unicas) {
    sub_df <- reordenamiento[reordenamiento$empresa_cat == emp, ]
    reord_lista[[emp]] <- list(df = sub_df, color = paleta_emp(emp), cant = nrow(sub_df))
  }
}

trazas_rel_info <- list()
