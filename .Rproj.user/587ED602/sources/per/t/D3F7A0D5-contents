library(jsonlite)

dir_web <- file.path(getwd(), "data_web")

obtener_json_atributos <- function(df) {
  if (is.null(df) || nrow(df) == 0) return("[]")
  df_no_geom <- st_drop_geometry(df)
  jsonlite::toJSON(df_no_geom, auto_unbox = TRUE, null = "null")
}

armar_popup_trazas <- function(df, nombre_capa) {
  if (is.null(df) || nrow(df) == 0) return(NULL)
  col_calle   <- names(df)[grep("calle|nomoficial|arteria", names(df), ignore.case = TRUE)][1]
  col_desde   <- names(df)[grep("desde|alt_derini|inicio", names(df), ignore.case = TRUE)][1]
  col_hasta   <- names(df)[grep("hasta|alt_izqfin|fin", names(df), ignore.case = TRUE)][1]
  col_empresa <- names(df)[grep("empresa|operador|prestador", names(df), ignore.case = TRUE)][1]
  
  calle_txt <- if (!is.na(col_calle)) as.character(df[[col_calle]]) else "-"
  desde_txt <- if (!is.na(col_desde)) as.character(df[[col_desde]]) else "-"
  hasta_txt <- if (!is.na(col_hasta)) as.character(df[[col_hasta]]) else "-"
  emp_txt   <- if (!is.na(col_empresa)) as.character(df[[col_empresa]]) else nombre_capa
  
  paste0(
    "<div style='font-family:sans-serif; font-size:12px;'>",
    "<b>Capa: </b>", nombre_capa, "<br>",
    "<b>Calle: </b>", calle_txt, "<br>",
    "<b>Desde: </b>", desde_txt, "<br>",
    "<b>Hasta: </b>", hasta_txt, "<br>",
    "<b>Empresa: </b>", emp_txt,
    "</div>"
  )
}

cargar_geojson <- function(nombre, geom_tipo = NULL) {
  path <- file.path(dir_web, paste0(nombre, ".geojson"))
  if (!file.exists(path)) return(NULL)
  d <- suppressWarnings(st_read(path, quiet = TRUE))
  if (nrow(d) == 0) return(NULL)
  if (!is.null(geom_tipo) && geom_tipo == "POINT") {
    d <- suppressWarnings(st_cast(d, "POINT"))
  }
  d
}

