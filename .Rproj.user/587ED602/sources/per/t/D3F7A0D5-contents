  pal_postes_rel <- colorFactor(palette = "Set2", domain = tipo_cats)
  postes_relevados$color_map <- pal_postes_rel(postes_relevados$tipo_cat)
  for (tp in tipo_cats) { postes_rel_info[[tp]] <- pal_postes_rel(tp) }
}

