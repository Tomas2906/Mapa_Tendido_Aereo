fila_capa <- function(id, nombre, color, checked = FALSE, cant = 0, info_list = NULL,
                      permitir_descarga = TRUE) {

  btn_info <- NULL
  if (!is.null(info_list) && length(info_list) > 0) {
    items_html <- sapply(names(info_list), function(k) {
      sprintf("<div class='popover-item'><span class='filtro-color' style='background:%s;'></span><span>%s</span></div>",
              info_list[[k]], k)
    })
    contenido_popover <- sprintf("<div class='popover-title'>Categorías - %s</div>%s",
                                 nombre, paste(items_html, collapse = ""))

    plantilla_popover <- tags$div(class = "popover-source", id = paste0("pop-", id),
                                  HTML(contenido_popover))

    btn_info <- tagList(
      tags$span(class = "btn-info-legend",
                `data-pop-id` = paste0("pop-", id),
                title = "Ver categorías",
                "ℹ️"),
      plantilla_popover
    )
  }

  btn_descarga <- NULL
  if (isTRUE(permitir_descarga)) {
    btn_descarga <- tags$span(class = "btn-download-legend",
                              `data-nombre` = nombre,
                              title = "Descargar esta capa en KML",
                              "📥")
  }

  tags$div(class = "filtro-item",
    tags$input(type = "checkbox", id = id,
               checked = if (checked) NA else NULL,
               `data-nombre` = nombre,
               `data-cant` = cant,
               class = "chk-capa"),
    tags$span(class = "filtro-color", style = sprintf("background:%s;", color)),
    tags$label(`for` = id, nombre),
    btn_info,
    btn_descarga
  )
}
