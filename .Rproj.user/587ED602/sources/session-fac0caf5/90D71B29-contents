subheader <- function(texto) {
  div(style = "font-weight:700; font-size:11px; color:#7f8c8d; letter-spacing:0.5px; margin:10px 0 4px;", toupper(texto))
}

item_leyenda <- function(color, etiqueta) {
  tags$div(
    style = "display:flex; align-items:center; gap:6px; padding:1px 0;",
    tags$span(style = paste0("width:10px; height:10px; min-width:10px; border-radius:3px; display:inline-block; background:", color, ";")),
    tags$span(style = "font-size:11px; color:#34495e;", etiqueta)
  )
}

capa_control <- function(inputId, label, value = FALSE, items = NULL) {
  desplegable <- NULL
  if (!is.null(items) && length(items) > 0) {
    desplegable <- tags$details(
      style = "flex-shrink:0;",
      tags$summary(style = "cursor:pointer; font-size:10px; color:#95a5a6; list-style:none; outline:none; padding:2px 4px;", HTML("Ver colores &#9662;")),
      tags$div(style = "margin: 4px 0 6px 6px; padding-left:8px; border-left:2px solid #ecf0f1;",
               do.call(tagList, lapply(names(items), function(n) item_leyenda(items[[n]], n))))
    )
  }
  tags$div(
    style = "display:flex; align-items:flex-start; justify-content:space-between; gap:4px;",
    tags$div(style = "flex:1; min-width:0;", checkboxInput(inputId, label, value = value)),
    desplegable
  )
}

