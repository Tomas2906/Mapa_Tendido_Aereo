obtener_atributo <- function(df, patron) {
  coincidencias <- names(df)[grep(patron, names(df), ignore.case = TRUE)]
  if (length(coincidencias) > 0) return(coincidencias[1]) else return(NULL)
}

limpiar_categoria <- function(x, default = "Sin Especificar") {
  x <- as.character(x)
  x[is.na(x) | trimws(x) == ""] <- default
  x
}

safe_read <- function(path, geom_type = NULL) {
  if (!file.exists(path)) {
    warning(sprintf("ARCHIVO NO ENCONTRADO: %s", path))
    return(NULL)
  }
  
  s2_estaba_activo <- sf_use_s2()
  sf_use_s2(FALSE)
  on.exit(sf_use_s2(s2_estaba_activo), add = TRUE)
  
  d <- tryCatch(st_read(path, quiet = TRUE), error = function(e) NULL)
  if (is.null(d)) return(NULL)
  
  if (is.na(st_crs(d))) {
    bbox_tmp <- tryCatch(suppressWarnings(st_bbox(st_geometry(d))), error = function(e) NULL)
    crs_inferido <- NA
    if (!is.null(bbox_tmp) && all(is.finite(bbox_tmp))) {
      if (abs(bbox_tmp[["xmin"]]) <= 180 && abs(bbox_tmp[["xmax"]]) <= 180 &&
          abs(bbox_tmp[["ymin"]]) <= 90  && abs(bbox_tmp[["ymax"]]) <= 90) {
        crs_inferido <- 4326
      } else {
        crs_inferido <- 5347
      }
    }
    if (!is.na(crs_inferido)) {
      st_crs(d) <- crs_inferido
    } else {
      return(NULL)
    }
  }
  
  n <- nrow(d)
  if (n == 0) return(suppressWarnings(st_transform(d, 4326)))
  
  geom_col <- st_geometry(d)
  ok <- rep(TRUE, n)
  geoms_limpias <- vector("list", n)
  
  multi_type <- if (!is.null(geom_type) && geom_type != "POINT") {
    switch(geom_type, "LINESTRING" = "MULTILINESTRING", "POLYGON" = "MULTIPOLYGON")
  } else NULL
  
  for (i in seq_len(n)) {
    resultado <- tryCatch({
      gi <- suppressWarnings(st_zm(geom_col[i], drop = TRUE, what = "ZM"))
      if (any(suppressWarnings(st_is_empty(gi)))) stop("vacío")
      if (!is.null(geom_type)) {
        gi <- suppressWarnings(st_collection_extract(gi, geom_type))
        if (length(gi) == 0 || any(suppressWarnings(st_is_empty(gi)))) stop("vacío")
        if (!is.null(multi_type)) gi <- suppressWarnings(st_cast(gi, multi_type))
      }
      gi
    }, error = function(e) NULL)
    
    if (is.null(resultado)) ok[i] <- FALSE else geoms_limpias[[i]] <- resultado
  }
  
  if (!any(ok)) return(suppressWarnings(st_transform(d[0, , drop = FALSE], 4326)))
  
  d_ok <- d[ok, , drop = FALSE]
  st_geometry(d_ok) <- do.call(c, geoms_limpias[ok])
  
  if (identical(geom_type, "POINT")) {
    tipos_geom <- tryCatch(unique(as.character(st_geometry_type(d_ok))), error = function(e) character())
    if (any(tipos_geom == "MULTIPOINT")) {
      d_ok <- tryCatch(suppressWarnings(st_cast(d_ok, "POINT", warn = FALSE)), error = function(e) d_ok)
    }
  }
  
  suppressWarnings(st_transform(d_ok, 4326))
}

calc_longitud <- function(d) {
  if (nrow(d) == 0) return(numeric(0))
  sf_use_s2(FALSE)
  on.exit(sf_use_s2(TRUE), add = TRUE)
  as.numeric(suppressWarnings(st_length(d)))
}

armar_popup <- function(nombre_capa, calle = "-", desde = "-", hasta = "-", empresa = NULL) {
  pop <- paste0("<div style='font-family: sans-serif; font-size: 12px;'>",
                "<b>Capa: </b>", nombre_capa, "<br>",
                "<b>Calle: </b>", calle, "<br>",
                "<b>Desde: </b>", desde, "<br>",
                "<b>Hasta: </b>", hasta)
  if (!is.null(empresa)) {
    pop <- paste0(pop, "<br><b>Empresa: </b>", empresa)
  }
  paste0(pop, "</div>")
}

extraer_atributos_calle <- function(df, nombre_capa, empresa_default = "Sin Especificar") {
  col_calle   <- obtener_atributo(df, "nomoficial|calle|arteria")
  
  col_derini <- obtener_atributo(df, "alt_derini")
  col_izqfin <- obtener_atributo(df, "alt_izqfin")
  
  if (!is.null(col_derini) && !is.null(col_izqfin)) {
    col_desde <- col_derini
    col_hasta <- col_izqfin
  } else {
    col_desde <- obtener_atributo(df, "desde|inicio|calle_desde")
    col_hasta <- obtener_atributo(df, "hasta|fin|calle_hasta")
  }
  
  col_empresa <- obtener_atributo(df, "empresa|operador|prestador")
  
  df$calle_fmt   <- if (!is.null(col_calle)) as.character(df[[col_calle]]) else "-"
  df$desde_fmt   <- if (!is.null(col_desde)) as.character(df[[col_desde]]) else "-"
  df$hasta_fmt   <- if (!is.null(col_hasta)) as.character(df[[col_hasta]]) else "-"
  df$empresa_fmt <- if (!is.null(col_empresa)) limpiar_categoria(df[[col_empresa]], empresa_default) else empresa_default
  df$popup_fmt   <- armar_popup(nombre_capa, df$calle_fmt, df$desde_fmt, df$hasta_fmt, df$empresa_fmt)
  df$longitud_m  <- calc_longitud(df)
  df
}

