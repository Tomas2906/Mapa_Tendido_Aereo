# =============================================================================
# 5. SERVIDOR (SERVER) - OPTIMIZADO
# =============================================================================
server <- function(input, output, session) {
  
  observeEvent(input$sel_comuna, {
    if (input$sel_comuna != "Todas") {
      barrios_filtrados <- barrios_sf %>%
        filter(as.character(.data[[col_comuna_barrios]]) == as.character(input$sel_comuna)) %>%
        pull(.data[[col_barrio_sf]]) %>% as.character() %>% unique() %>% sort()
      updateSelectInput(session, "sel_barrio", choices = c("Todos", barrios_filtrados), selected = "Todos")
    } else {
      updateSelectInput(session, "sel_barrio", choices = c("Todos", lista_barrios), selected = "Todos")
    }
  }, ignoreInit = FALSE)
  
  geo_filtro <- reactive({
    if (input$sel_barrio != "Todos") {
      barrios_sf %>% filter(as.character(.data[[col_barrio_sf]]) == input$sel_barrio)
    } else if (input$sel_comuna != "Todas") {
      comunas_sf %>% filter(as.character(.data[[col_comuna_sf]]) == input$sel_comuna)
    } else {
      NULL
    }
  })
  
  filtrar_capa <- function(sf_data, geom_type = "LINESTRING") {
    if (nrow(sf_data) == 0) return(sf_data)
    geo <- geo_filtro()
    
    if (is.null(geo) || nrow(geo) == 0) return(sf_data)
    
    res <- suppressWarnings(st_intersection(sf_data, st_geometry(geo)))
    if (nrow(res) == 0) return(res[0, , drop = FALSE])
    
    res <- suppressWarnings(st_collection_extract(res, geom_type)) %>%
      st_zm(drop = TRUE, what = "ZM") %>%
      filter(!st_is_empty(.))
    
    if (geom_type == "POINT" && nrow(res) > 0) {
      tipos_geom <- tryCatch(unique(as.character(st_geometry_type(res))), error = function(e) character())
      if (any(tipos_geom == "MULTIPOINT")) {
        res <- suppressWarnings(st_cast(res, "POINT", warn = FALSE))
      }
    }
    res
  }
  
  reord_r          <- reactive({ filtrar_capa(reordenamiento, "LINESTRING") })
  cao_r            <- reactive({ filtrar_capa(cao_metrotel, "LINESTRING") })
  aph_r            <- reactive({ filtrar_capa(zonas_aph, "POLYGON") })
  aph_trazas_r     <- reactive({ filtrar_capa(aph_trazas, "LINESTRING") })
  protocolo_r      <- reactive({ filtrar_capa(poligonos_protocolo, "POLYGON") })
  asi_aereo_r      <- reactive({ filtrar_capa(asi_aereo, "LINESTRING") })
  asi_sot_r        <- reactive({ filtrar_capa(asi_soterrado, "LINESTRING") })
  postes_r         <- reactive({ filtrar_capa(postes_relevados, "POINT") })
  tel_postes_r     <- reactive({ filtrar_capa(telefonica_postes, "POINT") })
  trazas_rel_r     <- reactive({ filtrar_capa(trazas_relevadas, "LINESTRING") })
  policia_r        <- reactive({ filtrar_capa(tendido_policia, "LINESTRING") })
  intimadas_r      <- reactive({ filtrar_capa(trazas_intimadas, "LINESTRING") })
  
  output$mapa <- renderLeaflet({
    leaflet() %>%
      addTiles(group = "OpenStreetMap") %>%
      setView(lng = -58.445, lat = -34.615, zoom = 12)
  })
  
  # --- 1. DIBUJO DE CAPAS EN EL MAPA (Se activa SOLO al cambiar el filtro territorial) ---
  observe({
    proxy <- leafletProxy("mapa")
    
    # Limpiamos los grupos vectoriales
    proxy %>% 
      clearGroup("Reordenamiento de Cables") %>% clearGroup("CAO Metrotel") %>%
      clearGroup("Zonas APH") %>% clearGroup("Trazas APH") %>% clearGroup("Polígonos Protocolo") %>%
      clearGroup("Tendido ASI - Aéreo") %>% clearGroup("Tendido ASI - Soterrado") %>%
      clearGroup("Postes Relevados") %>% clearGroup("Reordenamiento Telefónica - Postes") %>% 
      clearGroup("Trazas Relevadas") %>% clearGroup("Trazas Intimadas") %>% clearGroup("Tendido de Policía Federal")
    
    # Carga completa de vectores al grupo correspondiente
    if (nrow(aph_r()) > 0) {
      proxy %>% addPolygons(data = aph_r(), fillColor = ~pal_aph(cat_fmt), color = "#2c2c2c", weight = 2, opacity = 1, fillOpacity = 0.7, popup = ~popup_fmt, group = "Zonas APH")
    }
    if (nrow(aph_trazas_r()) > 0) {
      proxy %>% addPolylines(data = aph_trazas_r(), color = color_aph_trazas, weight = 4, opacity = 1, popup = ~popup_fmt, group = "Trazas APH")
    }
    if (nrow(protocolo_r()) > 0) {
      proxy %>% addPolygons(data = protocolo_r(), fillColor = ~pal_protocolo(cat_fmt), color = "#2c2c2c", weight = 2, opacity = 1, fillOpacity = 0.7, popup = ~popup_fmt, group = "Polígonos Protocolo")
    }
    if (nrow(asi_aereo_r()) > 0) {
      proxy %>% addPolylines(data = asi_aereo_r(), color = color_asi_aereo, weight = 4, opacity = 1, popup = ~popup_fmt, group = "Tendido ASI - Aéreo")
    }
    if (nrow(asi_sot_r()) > 0) {
      proxy %>% addPolylines(data = asi_sot_r(), color = color_asi_soterrado, weight = 4, opacity = 1, popup = ~popup_fmt, group = "Tendido ASI - Soterrado")
    }
    if (nrow(postes_r()) > 0) {
      proxy %>% addCircleMarkers(data = postes_r(), color = "#ffffff", fillColor = ~pal_postes(cat_fmt), radius = 6, stroke = TRUE, weight = 1, fillOpacity = 1, popup = ~popup_fmt, group = "Postes Relevados")
    }
    if (nrow(tel_postes_r()) > 0) {
      proxy %>% addCircleMarkers(data = tel_postes_r(), color = "#ffffff", fillColor = color_telefonica_postes, radius = 6, stroke = TRUE, weight = 1, fillOpacity = 1, popup = ~popup_fmt, group = "Reordenamiento Telefónica - Postes")
    }
    if (nrow(trazas_rel_r()) > 0) {
      proxy %>% addPolylines(data = trazas_rel_r(), color = ~pal_trazas_rel(empresa_fmt), weight = 4, opacity = 1, popup = ~popup_fmt, group = "Trazas Relevadas")
    }
    if (nrow(intimadas_r()) > 0) {
      proxy %>% addPolylines(data = intimadas_r(), color = color_trazas_intim, weight = 4.5, opacity = 1, dashArray = "4,4", popup = ~popup_fmt, group = "Trazas Intimadas")
    }
    if (nrow(policia_r()) > 0) {
      proxy %>% addPolylines(data = policia_r(), color = color_policia, weight = 4.5, opacity = 1, popup = ~popup_fmt, group = "Tendido de Policía Federal")
    }
    if (nrow(reord_r()) > 0) {
      proxy %>% addPolylines(data = reord_r(), color = ~pal_reord(empresa_fmt), weight = 4, opacity = 1, popup = ~popup_fmt, group = "Reordenamiento de Cables")
    }
    if (nrow(cao_r()) > 0) {
      proxy %>% addPolylines(data = cao_r(), color = color_cao_metrotel, weight = 4, opacity = 1, popup = ~popup_fmt, group = "CAO Metrotel")
    }
    
    # Aplicar inmediatamente la visibilidad actual basada en el estado de cada checkbox
    toggle_grupo <- function(condicion, nombre_grupo) {
      if (condicion) proxy %>% showGroup(nombre_grupo) else proxy %>% hideGroup(nombre_grupo)
    }
    
    toggle_grupo(input$chk_reord, "Reordenamiento de Cables")
    toggle_grupo(input$chk_cao_metrotel, "CAO Metrotel")
    toggle_grupo(input$chk_aph, "Zonas APH")
    toggle_grupo(input$chk_aph_trazas, "Trazas APH")
    toggle_grupo(input$chk_protocolo, "Polígonos Protocolo")
    toggle_grupo(input$chk_asi_aereo, "Tendido ASI - Aéreo")
    toggle_grupo(input$chk_asi_soterrado, "Tendido ASI - Soterrado")
    toggle_grupo(input$chk_postes, "Postes Relevados")
    toggle_grupo(input$chk_tel_postes, "Reordenamiento Telefónica - Postes")
    toggle_grupo(input$chk_trazas_rel, "Trazas Relevadas")
    toggle_grupo(input$chk_intimadas, "Trazas Intimadas")
    toggle_grupo(input$chk_policia, "Tendido de Policía Federal")
  })
  
  # --- 2. CONTROL RÁPIDO DE VISIBILIDAD (Súper fluido: No re-dibuja nada en Leaflet) ---
  observeEvent(input$chk_reord, { if(input$chk_reord) leafletProxy("mapa") %>% showGroup("Reordenamiento de Cables") else leafletProxy("mapa") %>% hideGroup("Reordenamiento de Cables") }, ignoreInit = TRUE)
  observeEvent(input$chk_cao_metrotel, { if(input$chk_cao_metrotel) leafletProxy("mapa") %>% showGroup("CAO Metrotel") else leafletProxy("mapa") %>% hideGroup("CAO Metrotel") }, ignoreInit = TRUE)
  observeEvent(input$chk_aph, { if(input$chk_aph) leafletProxy("mapa") %>% showGroup("Zonas APH") else leafletProxy("mapa") %>% hideGroup("Zonas APH") }, ignoreInit = TRUE)
  observeEvent(input$chk_aph_trazas, { if(input$chk_aph_trazas) leafletProxy("mapa") %>% showGroup("Trazas APH") else leafletProxy("mapa") %>% hideGroup("Trazas APH") }, ignoreInit = TRUE)
  observeEvent(input$chk_protocolo, { if(input$chk_protocolo) leafletProxy("mapa") %>% showGroup("Polígonos Protocolo") else leafletProxy("mapa") %>% hideGroup("Polígonos Protocolo") }, ignoreInit = TRUE)
  observeEvent(input$chk_asi_aereo, { if(input$chk_asi_aereo) leafletProxy("mapa") %>% showGroup("Tendido ASI - Aéreo") else leafletProxy("mapa") %>% hideGroup("Tendido ASI - Aéreo") }, ignoreInit = TRUE)
  observeEvent(input$chk_asi_soterrado, { if(input$chk_asi_soterrado) leafletProxy("mapa") %>% showGroup("Tendido ASI - Soterrado") else leafletProxy("mapa") %>% hideGroup("Tendido ASI - Soterrado") }, ignoreInit = TRUE)
  observeEvent(input$chk_postes, { if(input$chk_postes) leafletProxy("mapa") %>% showGroup("Postes Relevados") else leafletProxy("mapa") %>% hideGroup("Postes Relevados") }, ignoreInit = TRUE)
  observeEvent(input$chk_tel_postes, { if(input$chk_tel_postes) leafletProxy("mapa") %>% showGroup("Reordenamiento Telefónica - Postes") else leafletProxy("mapa") %>% hideGroup("Reordenamiento Telefónica - Postes") }, ignoreInit = TRUE)
  observeEvent(input$chk_trazas_rel, { if(input$chk_trazas_rel) leafletProxy("mapa") %>% showGroup("Trazas Relevadas") else leafletProxy("mapa") %>% hideGroup("Trazas Relevadas") }, ignoreInit = TRUE)
  observeEvent(input$chk_intimadas, { if(input$chk_intimadas) leafletProxy("mapa") %>% showGroup("Trazas Intimadas") else leafletProxy("mapa") %>% hideGroup("Trazas Intimadas") }, ignoreInit = TRUE)
  observeEvent(input$chk_policia, { if(input$chk_policia) leafletProxy("mapa") %>% showGroup("Tendido de Policía Federal") else leafletProxy("mapa") %>% hideGroup("Tendido de Policía Federal") }, ignoreInit = TRUE)
  
  # --- 3. ENFOQUE TERRITORIAL ---
  observe({
    leafletProxy("mapa") %>% clearGroup("limite_seleccionado")
    geo <- geo_filtro()
    if (!is.null(geo) && nrow(geo) > 0) {
      bbox <- st_bbox(geo)
      leafletProxy("mapa") %>%
        addPolygons(data = geo, color = "#2c3e50", weight = 3, fill = FALSE, dashArray = "6, 6", group = "limite_seleccionado") %>%
        flyToBounds(bbox[["xmin"]], bbox[["ymin"]], bbox[["xmax"]], bbox[["ymax"]])
    }
  })
  
  # --- 4. CÁLCULO DE MÉTRICAS Y TABLAS ---
  capas_visibles_sf <- reactive({
    layers <- list()
    if (input$chk_reord)        layers[["Reordenamiento de Cables"]]           <- reord_r()
    if (input$chk_cao_metrotel) layers[["CAO Metrotel"]]                       <- cao_r()
    if (input$chk_asi_aereo)    layers[["Tendido ASI - Aéreo"]]                <- asi_aereo_r()
    if (input$chk_asi_soterrado)layers[["Tendido ASI - Soterrado"]]            <- asi_sot_r()
    if (input$chk_trazas_rel)   layers[["Trazas Relevadas"]]                   <- trazas_rel_r()
    if (input$chk_aph_trazas)   layers[["Trazas APH"]]                         <- aph_trazas_r()
    if (input$chk_intimadas)    layers[["Trazas Intimadas"]]                   <- intimadas_r()
    if (input$chk_policia)      layers[["Tendido de Policía Federal"]]         <- policia_r()
    if (input$chk_postes)       layers[["Postes Relevados"]]                   <- postes_r()
    if (input$chk_tel_postes)   layers[["Reordenamiento Telefónica - Postes"]] <- tel_postes_r()
    layers
  })
  
  df_trazas_detalle <- eventReactive(input$btn_calcular, {
    layers <- capas_visibles_sf()
    if (length(layers) == 0) return(data.frame(Capa = character(), Empresa = character(), longitud_m = numeric(), Tipo = character(), Color = character(), stringsAsFactors = FALSE))
    
    partes <- lapply(names(layers), function(nombre_capa) {
      d <- layers[[nombre_capa]]
      if (nrow(d) == 0) return(NULL)
      empresa_vec <- if ("empresa_fmt" %in% names(d)) d$empresa_fmt else if ("cat_fmt" %in% names(d)) d$cat_fmt else nombre_capa
      long_vec    <- if ("longitud_m" %in% names(d)) d$longitud_m else 0
      tipo_geom   <- as.character(unique(st_geometry_type(d)))[1]
      
      color_vec <- switch(nombre_capa,
                          "CAO Metrotel"                       = color_cao_metrotel,
                          "Tendido ASI - Aéreo"                = color_asi_aereo,
                          "Tendido ASI - Soterrado"            = color_asi_soterrado,
                          "Trazas APH"                         = color_aph_trazas,
                          "Trazas Relevadas"                   = as.character(pal_trazas_rel(empresa_vec)),
                          "Trazas Intimadas"                   = color_trazas_intim,
                          "Tendido de Policía Federal"         = color_policia,
                          "Reordenamiento Telefónica - Postes" = color_telefonica_postes,
                          "Reordenamiento de Cables"           = as.character(pal_reord(empresa_vec)),
                          "#7F7F7F")
      
      data.frame(Capa = nombre_capa, Empresa = empresa_vec, longitud_m = long_vec, Tipo = tipo_geom, Color = color_vec, stringsAsFactors = FALSE)
    })
    bind_rows(partes)
  }, ignoreNULL = FALSE)
  
  output$tarjeta_registros <- renderUI({
    if (input$btn_calcular == 0) {
      return(div(style = "background: #7f8c8d; color: white; padding: 12px; border-radius: 8px; text-align: center;",
                 div(style = "font-size: 16px; font-weight: bold;", "-"),
                 div(style = "font-size: 11px; opacity: 0.9;", "Sin calcular")))
    }
    n <- nrow(df_trazas_detalle())
    div(style = "background: #2980b9; color: white; padding: 12px; border-radius: 8px; text-align: center; cursor: pointer;",
        div(style = "font-size: 20px; font-weight: bold;", format(n, big.mark = ".")),
        div(style = "font-size: 11px; opacity: 0.9;", "Registros Totales Visibles 🗎"))
  })
  
  output$tarjeta_km_totales <- renderUI({
    if (input$btn_calcular == 0) {
      return(div(style = "background: #7f8c8d; color: white; padding: 12px; border-radius: 8px; text-align: center;",
                 div(style = "font-size: 16px; font-weight: bold;", "-"),
                 div(style = "font-size: 11px; opacity: 0.9;", "Sin calcular")))
    }
    km <- sum(df_trazas_detalle()$longitud_m, na.rm = TRUE) / 1000
    div(style = "background: #27ae60; color: white; padding: 12px; border-radius: 8px; text-align: center;",
        div(style = "font-size: 20px; font-weight: bold;", format(round(km, 2), big.mark = ".", decimal.mark = ",")),
        div(style = "font-size: 11px; opacity: 0.9;", "KM Totales Visibles"))
  })
  
  observeEvent(input$btn_abrir_modal, {
    if (input$btn_calcular == 0) return(NULL)
    showModal(modalDialog(
      title = "Detalle de Capas Activas",
      size = "l", easyClose = TRUE,
      footer = tagList(
        downloadButton("descargar_excel", "Descargar Excel (.xlsx)", class = "btn-success"),
        modalButton("Cerrar")
      ),
      div(style = "max-height: 400px; overflow-y: auto;", tableOutput("tabla_original_unificada"))
    ))
  })
  
  output$tabla_original_unificada <- renderTable({
    if (input$btn_calcular == 0) return(data.frame(Mensaje = "Presione el botón 'Calcular' para cargar los datos."))
    layers <- capas_visibles_sf()
    if (length(layers) == 0) return(data.frame(Mensaje = "No hay capas visibles cargadas."))
    
    partes <- lapply(names(layers), function(nombre) {
      d <- layers[[nombre]]
      if (nrow(d) == 0) return(NULL)
      d_clean <- st_drop_geometry(d) %>% 
        select(-any_of(c("popup_fmt", "calle_fmt", "desde_fmt", "hasta_fmt", "empresa_fmt", "longitud_m", "cat_fmt")))
      d_clean <- cbind(Capa = nombre, d_clean)
      d_clean
    })
    bind_rows(partes)
  }, striped = TRUE, hover = TRUE, na = "-")
  
  output$descargar_excel <- downloadHandler(
    filename = function() { paste0("Tendido_Aereo_", Sys.Date(), ".xlsx") },
    content = function(file) {
      wb <- createWorkbook()
      layers <- capas_visibles_sf()
      
      for (nombre in names(layers)) {
        d <- layers[[nombre]]
        if (nrow(d) > 0) {
          d_clean <- st_drop_geometry(d) %>% 
            select(-any_of(c("popup_fmt", "calle_fmt", "desde_fmt", "hasta_fmt", "empresa_fmt", "longitud_m", "cat_fmt")))
          
          sheet_name <- substr(gsub("[^A-Za-z0-9_]", "_", nombre), 1, 31)
          addWorksheet(wb, sheet_name)
          writeData(wb, sheet_name, d_clean)
        }
      }
      saveWorkbook(wb, file, overwrite = TRUE)
    }
  )
  
  df_empresa_resumen <- reactive({
    if (input$btn_calcular == 0) return(data.frame(Empresa = character(), Tramos = numeric(), KM = numeric(), Color = character()))
    df <- df_trazas_detalle()
    if (nrow(df) == 0 || !"Tipo" %in% names(df)) return(data.frame(Empresa = character(), Tramos = numeric(), KM = numeric(), Color = character()))
    df <- df %>% filter(Tipo != "POINT")
    if (nrow(df) == 0) return(data.frame(Empresa = character(), Tramos = numeric(), KM = numeric(), Color = character()))
    df %>%
      group_by(Empresa, Color) %>%
      summarise(Tramos = n(), KM = sum(longitud_m, na.rm = TRUE) / 1000, .groups = "drop") %>%
      arrange(desc(Tramos))
  })
  
  output$grafico_tramos_dona <- renderPlotly({
    if (input$btn_calcular == 0) return(NULL)
    df <- df_empresa_resumen()
    if (nrow(df) == 0) return(NULL)
    plot_ly(df, labels = ~Empresa, values = ~Tramos, type = 'pie', hole = 0.5,
            marker = list(colors = ~Color),
            textinfo = 'label+percent', insidetextorientation = 'radial') %>%
      layout(margin = list(l = 10, r = 10, t = 10, b = 10), showlegend = FALSE)
  })
  
  output$grafico_km_empresa <- renderPlotly({
    if (input$btn_calcular == 0) return(NULL)
    df <- df_empresa_resumen()
    if (nrow(df) == 0) return(NULL)
    plot_ly(df, x = ~round(KM, 2), y = ~reorder(Empresa, KM), type = 'bar', orientation = 'h',
            marker = list(color = ~Color)) %>%
      layout(margin = list(l = 75, r = 10, t = 10, b = 30), xaxis = list(title = "Kilómetros"), yaxis = list(title = ""))
  })
  
  output$grafico_postes_tipo <- renderPlotly({
    if (input$btn_calcular == 0) return(NULL)
    
    df_p1 <- postes_r() %>% st_drop_geometry() %>% select(Tipo = cat_fmt)
    df_p2 <- tel_postes_r() %>% st_drop_geometry() %>% select(Tipo = cat_fmt)
    
    df_postes_comb <- bind_rows(df_p1, df_p2)
    if (nrow(df_postes_comb) == 0) return(NULL)
    
    resumen <- df_postes_comb %>%
      group_by(Tipo) %>%
      summarise(Cantidad = n(), .groups = "drop") %>%
      mutate(Color = ifelse(Tipo == "Reordenamiento Telefónica - Postes", color_telefonica_postes, as.character(pal_postes(Tipo)))) %>%
      arrange(desc(Cantidad))
    
    plot_ly(resumen, x = ~Cantidad, y = ~reorder(Tipo, Cantidad), type = 'bar', orientation = 'h',
            marker = list(color = ~Color)) %>%
      layout(margin = list(l = 100, r = 10, t = 10, b = 30), xaxis = list(title = "Cantidad de Postes"), yaxis = list(title = ""))
  })
}

