    mutate(empresa_split = strsplit(as.character(empresa_fmt), "[-/,_]")) %>%
    tidyr::unnest(empresa_split) %>%
    mutate(empresa_clean = trimws(empresa_split)) %>%
    filter(grepl("TELECENTRO|TELECOM", empresa_clean, ignore.case = TRUE)) %>%
    mutate(empresa_fmt = ifelse(grepl("TELECENTRO", empresa_clean, ignore.case = TRUE), "TELECENTRO", "TELECOM")) %>%
